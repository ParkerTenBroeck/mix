let
  ok = value: {ok=value};
  err = value: {err=value};
  faital = value: {faital=value};

  
  lex = let
    mkMatcher = kind: regex: 
                  let 
                    matcher = builtins.match ("^(\s*)("+regex+")(.*)$") 
                  in input: 
                    let
                      matched = matcher input;
                    in
                      if matched.len == 0 
                      then err false 
                      else ok {tok={kind,value=matched.2}, next = lex matched.3};
                    
    eof' = let 
              matcher = builtins.match "^(\s*)$" 
            in input: let
              matched = matcher input;
              eof = ok {tok={kind="eof",value=matched.1}, next = eof};
            in if matched.len == 0 
                then err false 
                else eof;
                
    num' = mkMatcher "num" "[0-9]+";
    ident' = mkMatcher "ident" "[a-zA-Z][a-zA-Z0-9'_]*";
    plus' = mkMatcher "plus" "\+";
    minus' = mkMatcher "minus" "-";
    times' = mkMatcher "times" "\*";
    div' = mkMatcher "div" "/";
    parenL' = mkMatcher "parenL" "\(";
    parenR' = mkMatcher "parenR" "\)";
  in str: 
    let 
      num = num' str;
      ident = ident' str;
      plus = plus' str;
      eof = eof' str;

      res = num.ok?ident.ok?plus.ok?eof.ok?false;
    in 
        if res == false 
        then err ("Failed to match " + str)
        else res;

    tokens = lex input;


    input = "3 meow 3 s'_" 
in tokens